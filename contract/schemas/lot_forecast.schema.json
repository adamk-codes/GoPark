{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lot_forecast",
  "type": "object",
  "properties": {
    "lot_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    },
    "expected_arrivals": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "lot_id",
    "date",
    "hour",
    "expected_arrivals"
  ],
  "additionalProperties": false
}
