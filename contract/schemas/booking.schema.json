{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "booking",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "booked",
        "completed",
        "cancelled",
        "no_show"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "plate": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "booking_id",
    "user_id",
    "location_id",
    "start_time",
    "end_time",
    "status"
  ],
  "additionalProperties": false
}
