{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sync_event",
  "type": "object",
  "properties": {
    "client_event_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "scan",
        "checkout",
        "walk_in",
        "resolve_alert",
        "override"
      ]
    },
    "lot_id": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object"
    }
  },
  "required": [
    "client_event_id",
    "type",
    "lot_id",
    "observed_at",
    "body"
  ],
  "additionalProperties": false
}
