{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vehicle_profile",
  "type": "object",
  "properties": {
    "color": { "enum": ["white", "silver", "black", "grey", "blue", "red", "green", "beige"] },
    "body": { "enum": ["sedan", "hatchback", "suv", "pickup", "van"] },
    "make": { "enum": ["Kia", "Toyota", "Hyundai", "Nissan", "Mercedes", "BMW"] },
    "model": { "type": ["string", "null"] }
  },
  "required": ["color", "body", "make"],
  "additionalProperties": false
}
