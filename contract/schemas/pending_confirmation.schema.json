{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pending_confirmation",
  "type": "object",
  "properties": {
    "stay": {
      "type": "object"
    },
    "booking": {
      "type": "object"
    },
    "question": {
      "enum": [
        "arrived",
        "left"
      ]
    },
    "p": {
      "type": [
        "number",
        "null"
      ]
    },
    "asked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "stay",
    "booking",
    "question",
    "p",
    "asked_at"
  ],
  "additionalProperties": false
}
